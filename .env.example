# Session
SESSION_SECRET=change-me-to-a-long-random-string

# Database (Postgres runs in Docker, app runs on host)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bbr-nation

# Server
NODE_ENV=development
PORT=3001

# ESPN Fantasy Football API
# leagueId: your ESPN league ID (visible in the league URL)
# espn_s2 + SWID: private league auth cookies (from browser devtools on espn.com)
# LEAGUE_START_YEAR: the first year your league existed (for historical backfill)
ESPN_LEAGUE_ID=
ESPN_LEAGUE_START_YEAR=
ESPN_S2=
ESPN_SWID=
