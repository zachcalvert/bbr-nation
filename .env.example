# ─── Session ──────────────────────────────────────────────────────────────────
# A long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Update user/password/host/db as needed.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bbr-nation

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── ESPN Fantasy Football API ───────────────────────────────────────────────
# ESPN_LEAGUE_ID: Your league's numeric ID. Find it in the URL when viewing
#   your league on espn.com (e.g. espn.com/football/league?leagueId=12345).
ESPN_LEAGUE_ID=

# ESPN_LEAGUE_START_YEAR: The first year your league existed. The backfill
#   will sync every season from this year to the present.
ESPN_LEAGUE_START_YEAR=

# ESPN_S2 and ESPN_SWID: Authentication cookies required for private leagues.
#   To find them:
#   1. Log in to espn.com in your browser
#   2. Open DevTools → Application → Cookies → espn.com
#   3. Copy the values for "espn_s2" and "SWID"
#   If your league is public, you can leave these blank.
ESPN_S2=
ESPN_SWID=
